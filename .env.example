# ==============================================================================
# The Comfort Trip Car Rentals — Environment Configuration Template
# Copy this file to .env.local and populate the secrets.
# DO NOT COMMIT .env OR .env.local TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HARD REQUIREMENTS (Must be set to run the application)
# ------------------------------------------------------------------------------

# MongoDB Atlas or Local connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/comfort_trip?retryWrites=true&w=majority"

# Auth.js / NextAuth encryption secret (generate with: npx auth secret or openssl rand -hex 32)
AUTH_SECRET="your-32-byte-hex-secret-here"
NEXTAUTH_SECRET="your-32-byte-hex-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Initial Super Admin Seed Key
ADMIN_SECRET_KEY="your-secure-internal-admin-seed-key"

# ------------------------------------------------------------------------------
# 2. DEFERRED REQUIREMENTS (Needed for specific feature modules)
# ------------------------------------------------------------------------------

# Google OAuth (Optional: for Google Single Sign-On)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary Media Storage (For Car Inventory & User Avatars)
CLOUDINARY_CLOUD_NAME="aaxxvbuu"
CLOUDINARY_API_KEY="177738146629223"
CLOUDINARY_API_SECRET="G5qFMYH4tj6-2vIWCNEloF0Q9s4"

# Transactional SMTP Email (Nodemailer: Welcome, Bookings, Driver Assignment)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMIN_NOTIFICATION_EMAIL=""

# Cron secret for automated booking reminders endpoint
CRON_SECRET=""

# Canonical Site URL for SEO and OpenGraph metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
